HR_AGENT_TOKEN_SECRET=change-this-demo-secret-before-production
VITE_API_BASE_URL=http://localhost:8080

# Optional MySQL profile. Leave SPRING_PROFILES_ACTIVE unset to use the default H2 database.
# SPRING_PROFILES_ACTIVE=mysql
DB_URL=jdbc:mysql://localhost:3306/hr_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=hr_agent
DB_PASSWORD=hr_agent

# Java -> Python Agent
AGENT_BASE_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=change-this-in-production
AGENT_TIMEOUT_SECONDS=30

# Python Agent -> Java internal tools. Keep the service token equal on both sides.
HR_AGENT_BACKEND_BASE_URL=http://localhost:8080
HR_AGENT_SERVICE_TOKEN=change-this-in-production
HR_AGENT_REQUEST_TIMEOUT_SECONDS=5

# Python Agent -> model (OpenAI-compatible chat completions).
# demo-rule-agent is local/deterministic and does not need an API key.
AGENT_MODELS=deepseek-chat,qwen-plus,qwen-max,doubao-pro-32k,doubao-lite-32k,gpt-4o-mini,demo-rule-agent
HR_AGENT_MODEL_OPTIONS=deepseek-chat,qwen-plus,qwen-max,doubao-pro-32k,doubao-lite-32k,gpt-4o-mini,demo-rule-agent
HR_AGENT_MODEL_NAME=deepseek-chat
HR_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
HR_AGENT_DEEPSEEK_API_KEY=replace-with-your-deepseek-key
HR_AGENT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HR_AGENT_QWEN_API_KEY=replace-with-your-qwen-key
HR_AGENT_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HR_AGENT_DOUBAO_API_KEY=replace-with-your-doubao-key
HR_AGENT_MODEL_BASE_URL=
HR_AGENT_MODEL_API_KEY=
HR_AGENT_MODEL_TIMEOUT_SECONDS=20
HR_AGENT_MODEL_MAX_TURNS=5
HR_AGENT_CONVERSATION_MAX_MESSAGES=20

# Java Spring AI runtime. Used when AGENT_RUNTIME=spring-ai.
CHAT_MODEL_BASE_URL=https://api.deepseek.com
CHAT_MODEL_API_KEY=replace-with-your-chat-key
CHAT_MODEL_NAME=deepseek-chat
EMBEDDING_MODEL_BASE_URL=https://api.openai.com
EMBEDDING_MODEL_API_KEY=replace-with-your-embedding-key
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
