# Python Agent -> Java Backend internal tools.
HR_AGENT_BACKEND_BASE_URL=http://localhost:8080
HR_AGENT_SERVICE_TOKEN=change-this-in-production
HR_AGENT_REQUEST_TIMEOUT_SECONDS=5

# Tool transport:
# - mcp: Python Agent calls Java MCP Server first, then falls back to Java Backend when needed.
# - backend: Python Agent calls Java Backend internal tools directly.
HR_AGENT_TOOL_TRANSPORT=mcp
HR_AGENT_MCP_BASE_URL=http://localhost:8090
HR_AGENT_MCP_ENDPOINT=/mcp
HR_AGENT_MCP_FALLBACK_TO_BACKEND=true

# Enabled model IDs shown in the frontend dropdown and accepted by the Python Agent.
# demo-rule-agent is local/deterministic and does not need an API key.
HR_AGENT_MODEL_OPTIONS=deepseek-chat,qwen-plus,qwen-max,doubao-pro-32k,doubao-lite-32k,gpt-4o-mini,demo-rule-agent
HR_AGENT_MODEL_NAME=deepseek-chat

# DeepSeek OpenAI-compatible endpoint.
HR_AGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
HR_AGENT_DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Alibaba Cloud DashScope / Qwen OpenAI-compatible endpoint.
HR_AGENT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HR_AGENT_QWEN_API_KEY=replace-with-your-qwen-key

# Volcano Engine Ark / Doubao OpenAI-compatible endpoint.
HR_AGENT_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
HR_AGENT_DOUBAO_API_KEY=replace-with-your-doubao-key

# Generic OpenAI-compatible fallback.
# Used for models that do not start with qwen/doubao and when provider-specific keys are empty.
HR_AGENT_MODEL_BASE_URL=
HR_AGENT_MODEL_API_KEY=

HR_AGENT_MODEL_TIMEOUT_SECONDS=20
HR_AGENT_MODEL_MAX_TURNS=5
HR_AGENT_MAX_TOOLS_PER_TURN=5
HR_AGENT_MAX_TOTAL_TOOL_CALLS=5
HR_AGENT_RUN_TIMEOUT_SECONDS=30

# Redis memory/checkpoint store.
# If your local Redis requires a password, use redis://:password@localhost:6379/0
HR_AGENT_REDIS_URL=redis://localhost:6379/0
HR_AGENT_REDIS_ENABLED=true
HR_AGENT_CONVERSATION_MAX_MESSAGES=20
HR_AGENT_CONVERSATION_TTL_SECONDS=86400
